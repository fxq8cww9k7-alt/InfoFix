# ==============================================================================
# InfoFIX - Configuración de Variables de Entorno (Backend)
# Copiar este archivo como .env y rellenar con valores reales para desarrollo
# ==============================================================================

# Puerto de la API REST
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos
# Ejemplo SQLite:
DB_TYPE=sqlite
DB_PATH=../database/infofix.sqlite
# Ejemplo PostgreSQL / MySQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=infopapu
# DB_PASS=secreto123
# DB_NAME=infofix_db

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_infofix_cucei_2026
JWT_EXPIRES_IN=8h

# Dominio Base para Enlaces de Verificación QR
# Debe apuntar al FRONTEND (página /verificar/<token>), que a su vez llama a GET /api/verificar/:token.
# En desarrollo local: http://localhost:5173 (Vite) o URL de túnel ngrok (T26)
PUBLIC_BASE_URL=http://localhost:5173

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Carpeta de fotos de evidencia (relativa a backend/)
UPLOADS_DIR=uploads

# Usuario administrador de DESARROLLO que crea `npm run seed` (no usar en producción)
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_EMAIL=admin@infofix.test
SEED_ADMIN_PASSWORD=Admin123!

# Límites de Multimedia (Multer - RF-05 y RF-07)
MAX_FILE_SIZE_BYTES=5242880
MAX_PHOTOS_PER_STAGE=5
ALLOWED_MIME_TYPES=image/jpeg,image/png

# Registro público de personal (pantalla P2): quien se registre debe escribir este código.
# Si se deja vacío, el registro queda deshabilitado y solo el admin puede crear cuentas.
CODIGO_TALLER=CAMBIA-ESTE-CODIGO

# Datos del taller para la nota de servicio y la página de estatus (P12, P15)
TALLER_NOMBRE=InfoFIX
TALLER_TELEFONO=3300000000
TALLER_DIRECCION=
TALLER_EMAIL=

# Correo saliente (recuperar contraseña P3 y avisos al cliente P10).
# Si SMTP_HOST está vacío, los correos se imprimen en la consola del servidor (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=InfoFIX <no-responder@infofix.test>

# Notificaciones automáticas (P5)
DIAS_ORDEN_DETENIDA=3
DIAS_AVISO_GARANTIA=7
