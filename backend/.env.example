# ==============================================================================
# InfoFIX - Configuración de Variables de Entorno (Backend)
# Copiar este archivo como .env y rellenar con valores reales para desarrollo
# ==============================================================================

# Puerto de la API REST
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos
# Ejemplo SQLite:
DB_TYPE=sqlite
DB_PATH=../database/infofix.sqlite
# Ejemplo PostgreSQL / MySQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=infopapu
# DB_PASS=secreto123
# DB_NAME=infofix_db

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_infofix_cucei_2026
JWT_EXPIRES_IN=8h

# Dominio Base para Enlaces de Verificación QR
# En desarrollo local: http://localhost:3000 o URL de túnel ngrok (T26)
PUBLIC_BASE_URL=http://localhost:3000

# Límites de Multimedia (Multer - RF-05 y RF-07)
MAX_FILE_SIZE_BYTES=5242880
MAX_PHOTOS_PER_STAGE=5
ALLOWED_MIME_TYPES=image/jpeg,image/png
